   "source": [
    "# insertion sort\n",
    "A = [12, 3, 9, 21, 15, 8]\n",
    "\n",
    "for i in range(1,len(A)):\n",
    "    temp = A[i]\n",
    "    j = i-1\n",
    "    while j >= 0 and A[j] > temp:\n",
    "        A[j+1] = A[j]\n",
    "        j = j-1\n",
    "    A[j+1] = temp\n",
    "print(A)"
   ]
  },
